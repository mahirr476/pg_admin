generator client {
  provider = "prisma-client-js"
  output   = "../../generated/global"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_GLOBAL")
}

model User {
  id          Int     @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String  @unique
  password    String
  roleId      Int
  role        Role    @relation(fields: [roleId], references: [id])
  status      UserStatus  @default(INACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Website {
  id          Int           @id @default(autoincrement())
  name        String
  domain      String        @unique
  status      WebsiteStatus @default(ACTIVE)
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Role {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  status    RoleStatus @default(ACTIVE)
  users             User[]
  rolePermission    RolePermission?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model RolePermission {
  id        Int       @id @default(autoincrement())
  roleId                Int      @unique
  role                  Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // Permission flags for paragon_group
  paragon_group_view    Boolean  @default(false)
  paragon_group_create  Boolean  @default(false)
  paragon_group_edit    Boolean  @default(false)
  paragon_group_delete  Boolean  @default(false)

  // Permission flags for parasole
  parasole_view    Boolean  @default(false)
  parasole_create  Boolean  @default(false)
  parasole_edit    Boolean  @default(false)
  parasole_delete  Boolean  @default(false)

  // Permission flags for user management
  user_view        Boolean  @default(false)
  user_create      Boolean  @default(false)
  user_edit        Boolean  @default(false)
  user_delete      Boolean  @default(false)

  // Permission flags for settings
  settings_view    Boolean  @default(false)
  settings_create  Boolean  @default(false)
  settings_edit    Boolean  @default(false)

  // Add other permission flags as needed
  dashboard    Boolean  @default(false)
  analytics_view   Boolean  @default(false)
}

model Permission {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum UserStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum WebsiteStatus {
  ACTIVE
  INACTIVE
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}
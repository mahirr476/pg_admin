generator client {
  provider = "prisma-client-js"
  output   = "../../generated/global"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_GLOBAL")
}

model User {
  id          Int     @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String  @unique
  password    String
  roleId      Int
  role        Role    @relation(fields: [roleId], references: [id])
  createdById  Int?
  // createdBy    User?     @relation("UserCreation", fields: [createdById], references: [id])
  // usersCreated User[]    @relation("UserCreation")
  auditLogs   AuditLog[]
  status      UserStatus  @default(INACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Website {
  id          Int           @id @default(autoincrement())
  name        String
  domain      String        @unique
  status      WebsiteStatus @default(ACTIVE)
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Role {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  status    RoleStatus @default(ACTIVE)
  users             User[]
  rolePermission    RolePermission?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model RolePermission {
  id        Int       @id @default(autoincrement())
  roleId                Int      @unique
  role                  Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // Permission flags for paragon_group
  paragon_group_view    Boolean  @default(false)
  paragon_group_create  Boolean  @default(false)
  paragon_group_edit    Boolean  @default(false)
  paragon_group_delete  Boolean  @default(false)

  // Permission flags for parasole
  parasole_view    Boolean  @default(false)
  parasole_create  Boolean  @default(false)
  parasole_edit    Boolean  @default(false)
  parasole_delete  Boolean  @default(false)

  // Permission flags for Aqua Breeder
  aqua_view    Boolean  @default(false)
  aqua_create  Boolean  @default(false)
  aqua_edit    Boolean  @default(false)
  aqua_delete  Boolean  @default(false)

  // Permission flags for Paragon Agro
  agro_view    Boolean  @default(false)
  agro_create  Boolean  @default(false)
  agro_edit    Boolean  @default(false)
  agro_delete  Boolean  @default(false)

  // Permission flags for Paragon Feed
  feed_view    Boolean  @default(false)
  feed_create  Boolean  @default(false)
  feed_edit    Boolean  @default(false)
  feed_delete  Boolean  @default(false)

  // Permission flags for Paragon Plastics
  plastics_view    Boolean  @default(false)
  plastics_create  Boolean  @default(false)
  plastics_edit    Boolean  @default(false)
  plastics_delete  Boolean  @default(false)

  // Permission flags for Paragon Plast Fiber
  plast_fiber_view    Boolean  @default(false)
  plast_fiber_create  Boolean  @default(false)
  plast_fiber_edit    Boolean  @default(false)
  plast_fiber_delete  Boolean  @default(false)

  // Permission flags for Paragon Poultry
  poultry_view    Boolean  @default(false)
  poultry_create  Boolean  @default(false)
  poultry_edit    Boolean  @default(false)
  poultry_delete  Boolean  @default(false)

  // Permission flags for Extra Comp
  extra1_view    Boolean  @default(false)
  extra1_create  Boolean  @default(false)
  extra1_edit    Boolean  @default(false)
  extra1_delete  Boolean  @default(false)

  // Permission flags for user management
  user_view        Boolean  @default(false)
  user_create      Boolean  @default(false)
  user_edit        Boolean  @default(false)
  user_delete      Boolean  @default(false)

  // Permission flags for settings
  settings_view    Boolean  @default(false)
  settings_create  Boolean  @default(false)
  settings_edit    Boolean  @default(false)

  // Add other permission flags as needed
  dashboard        Boolean  @default(false)
  analytics_view   Boolean  @default(false)
}

model Permission {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id            Int       @id @default(autoincrement())
  user_id       Int?
  user          User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)
  ip_address    String?   
  action        String
  entry_time    DateTime  @default(now())
  previous_state Json?
  new_state     Json?
  error_message String?
  entity_type   String
  entity_id     Int?
  user_agent    String?
  notes         String?
}

enum UserStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum WebsiteStatus {
  ACTIVE
  INACTIVE
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}
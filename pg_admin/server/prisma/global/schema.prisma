generator client {
  provider = "prisma-client-js"
  output   = "../../generated/global"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_GLOBAL")
}

model User {
  id          Int     @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String  @unique
  password    String
  roleId      Int
  status      UserStatus  @default(INACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Website {
  id          Int           @id @default(autoincrement())
  name        String
  domain      String        @unique
  status      WebsiteStatus @default(ACTIVE)
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Role {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  status    RoleStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Permission {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum UserStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum WebsiteStatus {
  ACTIVE
  INACTIVE
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}
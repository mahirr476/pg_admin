generator client {
  provider = "prisma-client-js"
  output   = "../../generated/parasole"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_PARASOLE")
}

model Hero {
  id              Int         @id @default(autoincrement())
  title           String
  description     String
  image           String
  index           Int         @unique
  createdBy       String
  createdAt       DateTime    @default(now())
  updatedBy       String
  updatedAt       DateTime    @updatedAt
  status          Status      @default(ACTIVE)
}

enum Status  {
  ACTIVE
  INACTIVE
}
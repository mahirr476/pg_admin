generator client {
  provider = "prisma-client-js"
  output   = "../../generated/group"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_GROUP")
}


model Hero {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  index         Int
  createdBy     String
  createdAt     DateTime @default(now())
  updatedBy     String
  updatedAt     DateTime @updatedAt
  status        HeroStatus @default(ACTIVE)
}

model Impact {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  number        String
  createdBy     String
  createdAt     DateTime @default(now())
  updatedBy     String
  updatedAt     DateTime @updatedAt
  status        ImpactStatus @default(ACTIVE)
}

model About {
  id              Int      @id @default(autoincrement())
  title           String
  description     String
  image           String
  mission         String @db.Text
  vision          String @db.Text
  commitedTitle   String
  commitedDescrip String @db.Text
  about           String @db.Text
  greenMission    String @db.Text
  extraField      String
  createdBy       String
  createdAt       DateTime @default(now())
  updatedBy       String
  updatedAt       DateTime @updatedAt
}

model Board {
  id            Int      @id @default(autoincrement())
  title         String   
  description   String   @db.Text
  createdBy     String
  createdAt     DateTime @default(now())
  updatedBy     String
  updatedAt     DateTime @updatedAt
}

model BoardOfDirector {
  id                 Int       @id @default(autoincrement())
  orderIndex         Int       @unique
  name               String   
  designation        String
  image              String
  shortDescription   String
  longDescription    String    @db.Text
  createdBy          String
  createdAt          DateTime  @default(now())
  updatedBy          String
  updatedAt          DateTime  @updatedAt
  status             BODStatus @default(ACTIVE)
}

model CSR {
  id                 Int       @id @default(autoincrement())
  orderIndex         Int       @unique
  title              String   
  description        String
  createdBy          String
  createdAt          DateTime  @default(now())
  updatedBy          String
  updatedAt          DateTime  @updatedAt
  status             CSRStatus @default(ACTIVE)
  details            CsrDetail[]
}

model CsrDetail {
  id                 Int       @id @default(autoincrement())
  csr_id             Int
  title              String   
  description        String
  image              String?
  createdBy          String
  createdAt          DateTime  @default(now())
  updatedBy          String?
  updatedAt          DateTime? @updatedAt
  csr                CSR       @relation(fields: [csr_id], references: [id], onDelete: Cascade)
}

model Milestone {
  id            Int      @id @default(autoincrement())
  title         String
  description   String   @db.Text
  orderIndex    Int       @unique   
  createdBy     String
  status        Milestonestatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedBy     String?
  updatedAt     DateTime? @updatedAt
}

model MilestoneDetail {
  id            Int      @id @default(autoincrement())
  year          String
  title         String
  description   String   @db.Text   
  image         String
  createdBy     String
  status        MileDetailstatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedBy     String?
  updatedAt     DateTime? @updatedAt
}

model Business {
  id           Int            @id @default(autoincrement())
  title        String
  bannerImage  String
  slug         String         @unique
  shortDes     String
  longDes      String         @db.Text   
  videoLink    String?
  image        String?
  createdBy    String
  status       BusinessStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedBy    String?
  updatedAt    DateTime?

  operations      BusinessOperation[]
  products        BusinessProduct[]
  units           BusinessUnit[]
  certifications  BusinessCertification[]
}

model BusinessOperation {
  id           Int                  @id @default(autoincrement())
  businessId   Int 
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title        String         
  description  String               @db.Text 
  createdBy    String
  status       BusinessOperationStatus @default(ACTIVE)
  createdAt    DateTime             @default(now())
  updatedBy    String?
  updatedAt    DateTime?
}

model BusinessProduct {
  id           Int                  @id @default(autoincrement())
  businessId   Int 
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title        String         
  description  String               @db.Text 
  createdBy    String
  status       BusinessProductStatus @default(ACTIVE)
  createdAt    DateTime             @default(now())
  updatedBy    String?
  updatedAt    DateTime?
}

model BusinessUnit  {
  id           Int                  @id @default(autoincrement())
  businessId   Int 
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title        String         
  description  String               @db.Text 
  createdBy    String
  status       BusinessUnitStatus   @default(ACTIVE)
  createdAt    DateTime             @default(now())
  updatedBy    String?
  updatedAt    DateTime?
}

model BusinessCertification  {
  id           Int                  @id @default(autoincrement())
  businessId   Int 
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title        String         
  description  String               @db.Text 
  image        String
  createdBy    String
  status       BusinessCertiStatus   @default(ACTIVE)
  createdAt    DateTime             @default(now())
  updatedBy    String?
  updatedAt    DateTime?
}

model Companies  {
  id                  Int            @id @default(autoincrement())
  title               String
  slug                String         @unique         
  image               String
  shortDes            String
  longDes             String         @db.Text
  founded             String
  teamSize            String
  location            String
  category            String
  globalPresence      String
  revenue             String
  clientSatisfaction  String
  createdBy           String
  status              CompaniesStatus   @default(ACTIVE)
  createdAt           DateTime          @default(now())
  updatedBy           String?
  updatedAt           DateTime?
}

enum CompaniesStatus  {
  ACTIVE
  INACTIVE
}

enum BusinessCertiStatus  {
  ACTIVE
  INACTIVE
}

enum BusinessUnitStatus  {
  ACTIVE
  INACTIVE
}

enum BusinessProductStatus  {
  ACTIVE
  INACTIVE
}

enum BusinessOperationStatus  {
  ACTIVE
  INACTIVE
}

enum BusinessStatus  {
  ACTIVE
  INACTIVE
}

enum Milestonestatus {
  ACTIVE
  INACTIVE
}

enum MileDetailstatus {
  ACTIVE
  INACTIVE
}

enum CSRStatus {
  ACTIVE
  INACTIVE
}

enum BODStatus {
  ACTIVE
  INACTIVE
}

enum HeroStatus {
  ACTIVE
  INACTIVE
}

enum ImpactStatus {
  ACTIVE
  INACTIVE
}
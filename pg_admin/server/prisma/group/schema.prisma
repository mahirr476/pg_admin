generator client {
  provider = "prisma-client-js"
  output   = "../../generated/group"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_GROUP")
}


model Hero {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  index         Int      @unique
  images        String[] @default([])
  createdBy     String
  createdAt     DateTime @default(now())
  updatedBy     String
  updatedAt     DateTime @updatedAt
  status        Status   @default(ACTIVE)
}

model Impact {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  number        String    @unique
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedBy     String
  updatedAt     DateTime  @updatedAt
  status        Status    @default(ACTIVE)
}

model About {
  id              Int      @id @default(autoincrement())
  title           String
  description     String
  image           String
  mission         String @db.Text
  vision          String @db.Text
  commitedTitle   String
  commitedDescrip String @db.Text
  about           String @db.Text
  greenMission    String @db.Text
  extraField      String
  createdBy       String
  createdAt       DateTime @default(now())
  updatedBy       String
  updatedAt       DateTime @updatedAt
}

model Board {
  id            Int      @id @default(autoincrement())
  title         String   
  description   String   @db.Text
  createdBy     String
  createdAt     DateTime @default(now())
  updatedBy     String
  updatedAt     DateTime @updatedAt
}

model BoardOfDirector {
  id                 Int       @id @default(autoincrement())
  orderIndex         Int       @unique
  name               String   
  designation        String
  image              String
  shortDescription   String
  longDescription    String    @db.Text
  createdBy          String
  createdAt          DateTime  @default(now())
  updatedBy          String
  updatedAt          DateTime  @updatedAt
  status             BODStatus @default(ACTIVE)
}

model CSR {
  id                 Int       @id @default(autoincrement())
  orderIndex         Int       @unique
  title              String   
  description        String
  createdBy          String
  createdAt          DateTime  @default(now())
  updatedBy          String
  updatedAt          DateTime  @updatedAt
  status             Status    @default(ACTIVE)
  details            CsrDetail[]
}

model CsrDetail {
  id                 Int       @id @default(autoincrement())
  csr_id             Int
  title              String   
  description        String
  image              String?
  createdBy          String
  createdAt          DateTime  @default(now())
  updatedBy          String?
  updatedAt          DateTime? @updatedAt
  csr                CSR       @relation(fields: [csr_id], references: [id], onDelete: Cascade)
  status             Status    @default(ACTIVE)
}

model Milestone {
  id            Int       @id @default(autoincrement())
  title         String
  description   String    @db.Text
  orderIndex    Int       @unique   
  image         String[]  @default([])
  createdBy     String
  status        Status    @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedBy     String?
  updatedAt     DateTime? @updatedAt
}

model MilestoneDetail {
  id            Int       @id @default(autoincrement())
  year          String
  title         String
  description   String    @db.Text   
  image         String
  createdBy     String
  status        Status    @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedBy     String?
  updatedAt     DateTime? @updatedAt
}

model Business {
  id           Int            @id @default(autoincrement())
  title        String
  bannerImage  String
  slug         String         @unique
  shortDes     String
  longDes      String         @db.Text   
  videoLink    String?
  image        String?
  createdBy    String
  status       Status         @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedBy    String?
  updatedAt    DateTime?

  operations      BusinessOperation[]
  products        BusinessProduct[]
  units           BusinessUnit[]
  certifications  BusinessCertification[]
}

model BusinessOperation {
  id           Int                  @id @default(autoincrement())
  businessId   Int 
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title        String         
  description  String               @db.Text 
  createdBy    String
  status       Status               @default(ACTIVE)
  createdAt    DateTime             @default(now())
  updatedBy    String?
  updatedAt    DateTime?
}

model BusinessProduct {
  id           Int                  @id @default(autoincrement())
  businessId   Int 
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title        String         
  description  String               @db.Text 
  createdBy    String
  status       Status               @default(ACTIVE)
  createdAt    DateTime             @default(now())
  updatedBy    String?
  updatedAt    DateTime?
}

model BusinessUnit  {
  id           Int                  @id @default(autoincrement())
  businessId   Int 
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title        String         
  description  String               @db.Text 
  createdBy    String
  status       Status               @default(ACTIVE)
  createdAt    DateTime             @default(now())
  updatedBy    String?
  updatedAt    DateTime?
}

model BusinessCertification  {
  id           Int                  @id @default(autoincrement())
  businessId   Int 
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title        String         
  description  String               @db.Text 
  image        String
  createdBy    String
  status       Status               @default(ACTIVE)
  createdAt    DateTime             @default(now())
  updatedBy    String?
  updatedAt    DateTime?
}

model Companies  {
  id                  Int            @id @default(autoincrement())
  title               String
  slug                String         @unique         
  image               String
  shortDes            String
  longDes             String         @db.Text
  founded             String
  teamSize            String
  location            String
  category            String
  globalPresence      String
  revenue             String
  clientSatisfaction  String
  createdBy           String
  status              Status    @default(ACTIVE)
  createdAt           DateTime  @default(now())
  updatedBy           String?
  updatedAt           DateTime?
}

model Media {
  id                  Int         @id @default(autoincrement())
  title               String
  orderIndex          Int         @unique
  description         String                 
  createdBy           String
  status              Status      @default(ACTIVE)
  createdAt           DateTime    @default(now())
  updatedBy           String?
  updatedAt           DateTime?
}

model MediaGallery {
  id                  Int         @id @default(autoincrement())
  title               String
  slug                String      @unique
  description         String                 
  image               String                 
  link                String                 
  createdBy           String
  status              Status      @default(ACTIVE)
  createdAt           DateTime    @default(now())
  updatedBy           String?
  updatedAt           DateTime?
}

model MediaNews {
  id                  Int         @id @default(autoincrement())
  title               String
  description         String      @db.Text            
  image               String                 
  link                String
  tag                 String
  date                String                 
  slug                String      @unique
  createdBy           String
  status              Status      @default(ACTIVE)
  createdAt           DateTime    @default(now())
  updatedBy           String?
  updatedAt           DateTime?
}

model MediaInquery {
  id                  Int         @id @default(autoincrement())
  title               String
  description         String      @db.Text            
  email               String                 
  contactNo           String
  website             String
  createdBy           String
  createdAt           DateTime    @default(now())
  updatedBy           String?
  updatedAt           DateTime?
}

model MediaContact {
  id                  Int         @id @default(autoincrement())
  name                String
  organization        String                
  email               String                 
  phone               String
  type                String
  message             String      @db.Text
  // createdBy           String
  createdAt           DateTime    @default(now())
  // updatedBy           String?
  // updatedAt           DateTime?
}

model ContactUs {
  id                  Int         @id @default(autoincrement())
  title               String
  description1        String     @db.Text           
  description2        String     @db.Text           
  location            String                 
  phone               String                 
  email               String                 
  workingHour         String
  googleMap           String      @db.Text
  facebook            String
  instagram           String
  twitter             String
  linkedin            String
  createdBy           String
  createdAt           DateTime    @default(now())
  updatedBy           String?
  updatedAt           DateTime?
}

model ContactUsForm {
  id                  Int         @id @default(autoincrement())
  name                String
  organization        String                
  email               String                 
  phone               String
  message             String      @db.Text
  createdAt           DateTime    @default(now())
}

enum Status  {
  ACTIVE
  INACTIVE
}

enum BODStatus {
  ACTIVE
  INACTIVE
}

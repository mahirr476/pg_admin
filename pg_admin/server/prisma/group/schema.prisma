generator client {
  provider = "prisma-client-js"
  output   = "../../generated/group"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_GROUP")
}


model Hero {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  index         Int
  createdBy     String
  createdAt     DateTime @default(now())
  updatedBy     String
  updatedAt     DateTime @updatedAt
  status        HeroStatus @default(ACTIVE)
}

model Impact {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  number        String
  createdBy     String
  createdAt     DateTime @default(now())
  updatedBy     String
  updatedAt     DateTime @updatedAt
  status        ImpactStatus @default(ACTIVE)
}

model About {
  id              Int      @id @default(autoincrement())
  title           String
  description     String
  image           String
  mission         String @db.Text
  vision          String @db.Text
  commitedTitle   String
  commitedDescrip String @db.Text
  about           String @db.Text
  greenMission    String @db.Text
  extraField      String
  createdBy       String
  createdAt       DateTime @default(now())
  updatedBy       String
  updatedAt       DateTime @updatedAt
}

model Board {
  id            Int      @id @default(autoincrement())
  title         String   @db.Text
  description   String
  createdBy     String
  createdAt     DateTime @default(now())
  updatedBy     String
  updatedAt     DateTime @updatedAt
}

model BoardOfDirector {
  id                 Int       @id @default(autoincrement())
  orderIndex         Int
  name               String   
  designation        String
  image              String
  shortDescription   String
  longDescription    String    @db.Text
  createdBy          String
  createdAt          DateTime  @default(now())
  updatedBy          String
  updatedAt          DateTime  @updatedAt
  status             BODStatus @default(ACTIVE)
}

enum BODStatus {
  ACTIVE
  INACTIVE
}

enum HeroStatus {
  ACTIVE
  INACTIVE
}

enum ImpactStatus {
  ACTIVE
  INACTIVE
}